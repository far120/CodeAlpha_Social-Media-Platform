################ BackEnd Configuration #############
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1

# Database Configuration (Use mongodb service name when running inside Docker Compose)
MONGODB_URI=mongodb://mongodb:27017/elfar_starter

# JWT Auth Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# AI Integration Providers Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

######## FrontEnd Configuration #########
FRONTEND_URL=http://localhost
VITE_API_BASE_URL=/api/v1
